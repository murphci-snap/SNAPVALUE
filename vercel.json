{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/slate",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    { "source": "/Players", "destination": "/" },
    { "source": "/Players/", "destination": "/" },
    { "source": "/Lineups", "destination": "/" },
    { "source": "/Lineups/", "destination": "/" },
    { "source": "/Bets", "destination": "/" },
    { "source": "/Cash", "destination": "/" },
    { "source": "/GPP", "destination": "/" },
    { "source": "/PPR", "destination": "/" }
  ]
}
